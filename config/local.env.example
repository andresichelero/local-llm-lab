# Copy to config/local.env (gitignored) and fill in this machine's paths.
# Every value is optional; unset values fall back to directories inside the clone
# (models/, cache/, envs/), which are also gitignored.
#
# MODEL_DIR=/path/to/model/storage
# HF_HOME=/path/to/huggingface/cache
# UV_CACHE_DIR=/path/to/uv/cache
# EXLLAMA_ENV_DIR=/path/to/exllamav3/venv
# TRAINING_ENV_DIR=/path/to/training/venv
