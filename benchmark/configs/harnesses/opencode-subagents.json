{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "local/Qwen3.5-9B-Q4_K_M",
  "default_agent": "build",
  "subagent_depth": 1,
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local llama.cpp on WSL SSD",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "local"
      },
      "models": {
        "Qwen3.5-9B-Q4_K_M": {
          "name": "Qwen3.5-9B-Q4_K_M",
          "limit": { "context": 16384, "output": 1024 },
          "options": { "temperature": 0 }
        }
      }
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "steps": 10,
      "permission": {
        "task": {
          "*": "deny",
          "repo-explorer": "allow",
          "independent-reviewer": "allow"
        }
      }
    },
    "repo-explorer": {
      "description": "Read-only worker for finding files and reporting a narrow codebase question.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "independent-reviewer": {
      "description": "Read-only reviewer that independently inspects a diff and its test evidence.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  }
}
